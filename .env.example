# Copy to .env (gitignored). sqlx reads DATABASE_URL at compile and test time.
DATABASE_URL=postgres://factory:factory@localhost:15433/dark_factory

# Canonical public URI of the MCP resource. Tokens are audience-bound to this
# (RFC 8707); a token minted for any other resource is rejected.
DF_RESOURCE_URI=http://localhost:8080/mcp

# Public base URL of the authorization server + console.
DF_PUBLIC_URL=http://localhost:8080

DF_BIND=0.0.0.0:8080

# Trust X-Forwarded-For for the client address used in rate limiting and the
# audit trail. Off locally (nothing here overwrites the header). Fly.io's own
# edge proxy does, so fly.toml sets this to 1 in production. Turning it on
# without such a proxy in front lets an attacker rotate the header and walk
# straight through every per-source throttle.
DF_TRUST_FORWARDED_FOR=0

# 32 bytes, base64. Encrypts TOTP shared secrets and tracker credentials at rest.
# Generate: openssl rand -base64 32
DF_ENCRYPTION_KEY=

# 32 bytes, base64. Signs session cookies and magic links.
# Generate: openssl rand -base64 32
DF_SIGNING_KEY=

# Refuse billable tool calls once an org on a hard-stop plan is past its bucket.
# Off until milestone 2: usage is recorded from day one, but refusing work over a
# counter nobody has watched in anger yet is a support incident, not revenue.
# Reads keep working even when this is on.
DF_ENFORCE_QUOTAS=0

# Where a caller who has run out is sent. Named in the refusal itself, because an
# error that says "upgrade" without saying where is a dead end for an agent.
# Defaults to $DF_PUBLIC_URL/settings/billing.
DF_UPGRADE_URL=

# No real SMTP/mail-provider integration exists yet (milestone 1 scope).
# df-server refuses to start without this set, because starting with the
# LogMailer fallback silently means verification/recovery/invitation emails
# are never delivered. Set to 1 to run anyway, with those emails written to
# this process's logs (see RUST_LOG below) instead of sent.
DF_ALLOW_LOG_MAILER=1

# df_web=debug is what makes LogMailer's message bodies visible locally —
# verification/recovery/invitation links included. It deliberately logs those
# at `debug`, not `warn`, so a production RUST_LOG (which stays at `info`)
# never puts a plaintext single-use credential in a retained log stream.
RUST_LOG=info,df_server=debug,df_mcp=debug,df_web=debug
