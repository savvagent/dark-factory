# Copy to .env (gitignored). sqlx reads DATABASE_URL at compile and test time.
DATABASE_URL=postgres://factory:factory@localhost:15433/dark_factory

# Canonical public URI of the MCP resource. Tokens are audience-bound to this
# (RFC 8707); a token minted for any other resource is rejected.
DF_RESOURCE_URI=http://localhost:8080/mcp

# Public base URL of the authorization server + console.
DF_PUBLIC_URL=http://localhost:8080

DF_BIND=0.0.0.0:8080

# 32 bytes, base64. Encrypts TOTP shared secrets and tracker credentials at rest.
# Generate: openssl rand -base64 32
DF_ENCRYPTION_KEY=

# 32 bytes, base64. Signs session cookies and magic links.
# Generate: openssl rand -base64 32
DF_SIGNING_KEY=

# Enforce plan quotas on billable tools. Off until milestone 2.
DF_ENFORCE_QUOTAS=0

RUST_LOG=info,df_server=debug,df_mcp=debug
